# Database (PostgreSQL 17) - Use psycopg 3 driver
# Format: postgresql+psycopg://<username>:<password>@localhost:5432/Heritage_DBJournal
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@localhost:5432/Heritage_DBJournal

# Qdrant Vector Search
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=heritage_chunks

# Embeddings (BAAI/bge-m3, 1024-dim dense)
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=auto

# CORS Origins (JSON array)
CORS_ORIGINS=["http://localhost:5173"]
